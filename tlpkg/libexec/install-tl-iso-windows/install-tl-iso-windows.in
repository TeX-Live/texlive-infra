#define version <year>
#define innoscript <installer>
#define launcher <script>

[Setup]
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
AppName=TeX Live
AppVerName=TeX Live {#version}
AppPublisherURL=https://tug.org/texlive
WizardStyle=modern
PrivilegesRequiredOverridesAllowed=dialog commandline
DefaultDirName={autopf}
DisableDirPage=yes
Uninstallable=no
OutputDir=.
OutputBaseFilename={#innoscript}
Compression=zip/9
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl";
Name: "chineseSimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl";
; Name: "czech"; MessagesFile: "compiler:Languages\Czech.isl";
; Name: "danish"; MessagesFile: "compiler:Languages\Danish.isl";
; Name: "dutch"; MessagesFile: "compiler:Languages\Dutch.isl";
Name: "french"; MessagesFile: "compiler:Languages\French.isl";
; Name: "german"; MessagesFile: "compiler:Languages\German.isl";
; Name: "italian"; MessagesFile: "compiler:Languages\Italian.isl";
; Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl";
; Name: "polish"; MessagesFile: "compiler:Languages\Polish.isl";
; Name: "portuguese"; MessagesFile: "compiler:Languages\Portuguese.isl";
; Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl";
; Name: "slovak"; MessagesFile: "compiler:Languages\Slovak.isl";
; Name: "slovenian"; MessagesFile: "compiler:Languages\Slovenian.isl";
; Name: "serbian"; MessagesFile: "Serbian.isl";
; Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl";
; Name: "ukrainian"; MessagesFile: "compiler:Languages\Ukrainian.isl";
; Name: "vietnamese"; MessagesFile: "Vietnamese.isl";

[CustomMessages]
TLWelcomeCaption=TeX Live ISO Installer Launcher
TLWelcomeDescription=Installation of TeX Live from an ISO image.
TLWelcomeMessage=This setup wizard will download the official TeX Live ISO image, and then launch the TeX Live installer.%n%nYou will need to select a repository to download the ISO from on the next page.%n%nDownloading the ISO image will take time. Once the download is complete, no Internet access is needed during the installation.
TLMirrorCaption=Repository for the ISO image
TLMirrorDescription=Closer is better.
TLMirrorSubCaption=Please select a nearby repository to download the ISO image from, then click Next.
TLMirrorAutomatic=Automatic
TLUpdateCaption=Update TeX Live?
TLUpdateSubCaption=The wizard may now update the TeX Live infrastructure and all installed packages to the latest versions available.%n%nThis optional step may take a lot of time. You may also update later using TeX Live Manager.%n%nIf you proceed, you will have to specify the installation folder of TeX Live on the next page.
TLDirCaption=TeX Live Installation Folder
TLDirSubCaption=Choose the folder containing the TeX Live {#version} tree.%n%nThe TeX Live installer default location is preselected below. To continue, click Next.%n%nIf you chose a different folder in the TeX Live installer, click Browse to select it.
TLFailedUpdate=Update failed. Check the TeX Live path.
french.TLWelcomeCaption=Lanceur de l'installateur de TeX Live
french.TLWelcomeDescription=Installation de TeX Live depuis l'image ISO.
french.TLWelcomeMessage=Cet assistant d'installation va télécharger l'image ISO officielle de TeX Live, puis lancer l'installateur de TeX Live.%n%nVous devrez sélectionner un site de téléchargement de l'image ISO à l'écran suivant.%n%nLe téléchargement prendra du temps. Une fois le téléchargement terminé, l'accès à Internet n'est plus requis pour l'installation.
french.TLMirrorCaption=Site de téléchargement de l'image ISO
french.TLMirrorDescription=Plus près, c'est mieux.
french.TLMirrorSubCaption=Choisissez un site de téléchargement de l'image ISO près de vous, puis cliquez sur Suivant.
french.TLMirrorAutomatic=Automatique
french.TLUpdateCaption=Mettre à jour TeX Live?
french.TLUpdateSubCaption=L'assistant peut maintenant mettre à jour l'infrastructure de TeX Live et tous ses paquetages vers les plus récentes versions disponibles.%n%nCette étape optionnelle peut prendre beaucoup de temps. Vous pouvez aussi effectuer la mise à jour plus tard avec TeX Live Manager.%n%nSi vous allez de l'avant, vous devrez spécifier le dossier d'installation de TeX Live à l'écran suivant.
french.TLDirCaption=Dossier d'installation de TeX Live
french.TLDirSubCaption=Choisir le dossier qui contient l'arborescence de TeX Live {#version}. L'emplacement par défaut de l'installateur de TeX Live est présélectionné ci-dessous. Pour continuer cliquer sur Suivant.%n%nSi vous avez choisi un autre emplacement dans l'installateur de TeX Live, cliquer sur Parcourir pour le sélectionner.
french.TLFailedUpdate=Échec de la mise à jour. Vérifiez le chemin d'accès de TeX Live.
chineseSimplified.TLWelcomeCaption=TeX Live ISO 安装程序启动器
chineseSimplified.TLWelcomeDescription=从 ISO 镜像安装 TeX Live
chineseSimplified.TLWelcomeMessage=本安装向导将下载官方 TeX Live ISO 镜像，然后启动 TeX Live 安装程序。%n%n您需要在下一页选择用于下载 ISO 镜像的站点。%n%n下载 ISO 镜像需要一些时间。下载完成后，安装过程中无需连接互联网。
chineseSimplified.TLMirrorCaption=ISO 镜像下载站点
chineseSimplified.TLMirrorDescription=越近越好
chineseSimplified.TLMirrorSubCaption=请选择一个离您较近的 ISO 镜像下载站点，然后点击“下一步”。
chineseSimplified.TLMirrorAutomatic=自动

[Files] 
Source: "{tmp}\texlive.iso"; Flags: dontcopy external
Source: "{#launcher}"; DestDir: "{tmp}"

[Run]
Filename: "powershell.exe"; \
  Parameters: "-ExecutionPolicy Bypass -File ""{tmp}\{#launcher}"" {tmp}\texlive.iso"; \
  WorkingDir: {tmp}; Flags: runhidden

[Code] 
var
  OutputMsgWizardPage: TOutputMsgWizardPage;
  DownloadPage: TDownloadWizardPage;
  MirrorPage: TInputOptionWizardPage;
  UpdatePage: TInputOptionWizardPage;
  TeXLiveDirPage: TInputDirWizardPage;
  Url: String;
 
procedure InitializeWizard();
begin
  OutputMsgWizardPage := CreateOutputMsgPage(wpWelcome,
    ExpandConstant('{cm:TLWelcomeCaption}'),
    ExpandConstant('{cm:TLWelcomeDescription}'),
    ExpandConstant('{cm:TLWelcomeMessage}'));
  
  MirrorPage := CreateInputOptionPage(OutputMsgWizardPage.ID,
    ExpandConstant('{cm:TLMirrorCaption}'),
    ExpandConstant('{cm:TLMirrorDescription}'),
    ExpandConstant('{cm:TLMirrorSubCaption}'),
    True, True);
  MirrorPage.Add(ExpandConstant('{cm:TLMirrorAutomatic}') + ' (mirrors.ctan.org)');
  MirrorPage.Values[0] := True;
      
  DownloadPage := CreateDownloadPage(
    SetupMessage(msgWizardPreparing),
    SetupMessage(msgPreparingDesc),
    nil);
  DownloadPage.ShowBaseNameInsteadOfUrl := True;

  UpdatePage := CreateInputOptionPage(wpInstalling + 1,
    ExpandConstant('{cm:TLUpdateCaption}'),
    '',
    ExpandConstant('{cm:TLUpdateSubCaption}'),
    False, False);
  UpdatePage.Add('Update all packages to current version');
  
  TeXLiveDirPage := CreateInputDirPage(UpdatePage.ID, 
    ExpandConstant('{cm:TLDirCaption}'),
    '',
    ExpandConstant('{cm:TLDirSubCaption}'),
    False, '');
  TeXLiveDirPage.Add('');
  TeXLiveDirPage.Values[0] := ExpandConstant('{sd}') + '\texlive\' + '{#version}';  
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  Error: String;
  ResultCode: Integer;
begin
  if CurPageID = MirrorPage.ID then
  begin
    case MirrorPage.SelectedValueIndex of
      0: Url := 'https://mirrors.ctan.org';
    end;
  end;
  if CurPageID = wpReady then
  begin
    DownloadPage.Clear;
    DownloadPage.Add(Url + '/systems/texlive/Images/texlive.iso', 'texlive.iso', '');
    DownloadPage.Show;
    try
      try
        DownloadPage.Download;
        Result := True;
      except
        if DownloadPage.AbortedByUser then
          Log('Aborted by user.')
        else begin
          Error := Format('%s: %s', [DownloadPage.LastBaseNameOrUrl, GetExceptionMessage]);
          SuppressibleMsgBox(AddPeriod(Error), mbCriticalError, MB_OK, IDOK);
        end;
        Result := False;
      end;
    finally
      DownloadPage.Hide;
    end;
  end;
  if CurPageID = TeXLiveDirPage.ID then
  begin
    if not Exec('tlmgr.bat', 'update --self --all', 
      TeXLiveDirPage.Values[0] + '\bin\windows\', 
      SW_SHOWNORMAL, ewWaitUntilTerminated, ResultCode) then
    begin
      MsgBox(ExpandConstant('{cm:TLFailedUpdate}'), mbError, MB_OK);
    end;
  end;
  Result := True;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if PageID = TeXLiveDirPage.ID then
  begin
    Result := not UpdatePage.SelectedValueIndex = 0;
  end;
end;
